# JCFAdmin environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env` (it is gitignored).
# Secret values must live here locally and in your host's env vars in production —
# never in source code or the Flutter app.

# ----------------------------------------------------------------------------
# Core Django
# ----------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=                       # generate a long random string
# Comma-separated; defaults to * when unset
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed for CSRF (production domains)
CSRF_TRUSTED_ORIGINS=https://jancosmicfoundation.org,https://*.jancosmicfoundation.org

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
# Local example: postgres://USER:PASSWORD@localhost:5432/jcf_management
DATABASE_URL=

# ----------------------------------------------------------------------------
# Cloudflare R2 Storage (S3-compatible)
# Leave CLOUDFLARE_R2_BUCKET empty to use local filesystem storage instead.
# ----------------------------------------------------------------------------
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_PUBLIC_DOMAIN=

# ----------------------------------------------------------------------------
# Email (Google SMTP) — used for member OTP login codes + transactional mail
# ----------------------------------------------------------------------------
# In dev, print emails to the console instead of sending:
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST_USER=                  # Gmail address that sends the mail
EMAIL_HOST_PASSWORD=              # Gmail APP PASSWORD (not the account password)
DEFAULT_FROM_EMAIL=JCF <noreply@jancosmicfoundation.org>

# ----------------------------------------------------------------------------
# SMS (Arkesel)
# ----------------------------------------------------------------------------
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=JCF

# ----------------------------------------------------------------------------
# CORS — origins allowed to call the API (the website; mobile sends no Origin)
# ----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----------------------------------------------------------------------------
# Paystack
# Secret key is server-only. Public key is safe in the client and is served to
# the app at runtime (stored on RetreatConfig) so it can rotate without releases.
# ----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=              # sk_test_... (dev)  /  sk_live_... (prod)
PAYSTACK_PUBLIC_KEY=             # pk_test_... / pk_live_... (public, optional here)
# PAYSTACK_WEBHOOK_SECRET=        # only if you verify webhooks with a separate secret

# ----------------------------------------------------------------------------
# Firebase Cloud Messaging (push notifications)
# ----------------------------------------------------------------------------
# Leave FCM_ENABLED false until a Firebase service account is provisioned;
# pushes are logged and skipped while off.
FCM_ENABLED=false
# FIREBASE_SERVICE_ACCOUNT=        # path/JSON of the FCM service account (server only)

# ----------------------------------------------------------------------------
# JWT (mobile auth — added in Track B; RS256 key pair)
# ----------------------------------------------------------------------------
# JWT_PRIVATE_KEY=                # signs access tokens — server only
# JWT_PUBLIC_KEY=                 # verifies tokens — safe to distribute
