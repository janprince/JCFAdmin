# =============================================================================
# JCF Management Dashboard — environment variables
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.
# Only SECRET_KEY is strictly required; everything else has a safe default.
# =============================================================================

# --- Core Django ---
SECRET_KEY=change-me-to-a-long-random-string          # REQUIRED
DEBUG=True                                             # default: False (set False in prod)
# Comma-separated. Defaults to '*' — lock this down in production.
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated. Defaults to the Railway + jancosmicfoundation.org origins.
CSRF_TRUSTED_ORIGINS=https://jancosmicfoundation.org,https://*.jancosmicfoundation.org

# --- Database ---
# default: postgres://localhost:5432/jcf_management
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/jcf_management

# --- Cloudflare R2 media storage (S3-compatible) ---
# Leave CLOUDFLARE_R2_BUCKET blank to store media on the local filesystem.
# If set, the four *_ACCESS/SECRET/ENDPOINT vars below become REQUIRED.
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_PUBLIC_DOMAIN=

# --- Email (Gmail SMTP) ---
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=                                  # Gmail app password
DEFAULT_FROM_EMAIL=JCF <noreply@jancosmicfoundation.org>

# --- Arkesel SMS ---
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=JCF

# --- CORS (public website / Next.js frontend) ---
# Comma-separated. default: http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Paystack (donations) ---
PAYSTACK_SECRET_KEY=
